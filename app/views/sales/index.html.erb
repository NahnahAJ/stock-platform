<!-- app/views/sales/index.html.erb -->
<h1>All Sales</h1>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Customer</th>
      <th>Total</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% @sales.each do |sale| %>
      <tr>
        <td><%= sale.id %></td>
        <td><%= sale.customer.name if sale.customer %></td>
        <td><%= number_to_currency(sale.total) %></td>
        <td><%= sale.created_at.to_date %></td>
      </tr>
    <% end %>
  </tbody>
</table>
